---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const technologies = [
  { name: "HTML", icon: "/img/logos/html_icon.svg" },
  { name: "CSS", icon: "/img/logos/css_icon.svg" },
  { name: "JavaScript", icon: "/img/logos/js_icon.svg" },
  { name: "React", icon: "/img/logos/react_icon.svg" },
  { name: "TypeScript", icon: "/img/logos/typescript_icon.svg" },
  { name: "Python", icon: "/img/logos/python_icon.svg" },
  { name: "PostgreSQL", icon: "/img/logos/postgresql_icon.svg" },
  { name: "Tailwind CSS", icon: "/img/logos/Tailwind_icon.svg" },
  { name: "Docker", icon: "/img/logos/docker_icon.svg" },
  { name: "Linux", icon: "/img/logos/linux_icon.svg" },
  { name: "Git", icon: "/img/logos/git_icon.svg" },
  { name: "Github", icon: "/img/logos/github_icon.svg" },
  { name: "Odoo", icon: "/img/logos/Odoo_logo.svg" },
  { name: "n8n", icon: "/img/logos/n8n_icon.svg" },
  { name: "C#", icon: "/img/logos/csharp_icon.svg" }
];
---

<section id="about" class="full-width h-full py-10 px-4 sm:px-8 lg:px-16 xl:px-32 bg-gray-100 text-dark">
  <div class="relative max-w-[1200px] mx-auto p-4 z-10">
    <div class="flex flex-row items-center gap-3 text-3xl sm:text-4xl">
      <h2>{t.about.title}</h2>
    </div>
    <div class="lg:grid-cols-3 gap-8 lg:gap-10 my-5 mb-8">
      <div class="lg:col-span-2 flex flex-col justify-between gap-8">
        <div class="group bg-white border border-gray-200 rounded-2xl overflow-hidden transition-all duration-300 hover:border-primary shadow-sm flex flex-col">
          <div class="p-6 flex-grow flex flex-col">
            <h3 class="text-2xl font-semibold mb-8">{t.about.introduction}</h3>
            <div class="flex flex-col lg:flex-row justify-between gap-8 text-gray-600 leading-relaxed">
              <p set:html={t.about.introText} />
            </div>
          </div>
        </div>
        <div class="group bg-grey border border-gray-200 rounded-2xl overflow-hidden transition-all duration-300 hover:border-primary shadow-sm flex flex-col">
          <div class="p-6 flex-grow flex flex-col">
            <h3 class="text-2xl font-semibold mb-8 text-center lg:text-left">{t.about.technologies}</h3>
            <div class="flex flex-wrap gap-x-2 gap-y-4 justify-center lg:justify-start ">
              {technologies.map(tech => (
                <div class="flex items-center gap-2 px-4 py-2 border border-gray-200 rounded-xl bg-dark-50 hover:bg-gray-100 transition-all ease cursor-default">
                  <img src={tech.icon} alt={`${tech.name} logo`} class="w-5 h-5 object-contain">
                  <span class="text-dark">{tech.name}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="group bg-white border border-gray-200 rounded-2xl overflow-hidden transition-all duration-300 hover:border-primary shadow-sm flex flex-col">
            <div class="p-6 flex-grow flex flex-row items-center">
              <div class="p-3 rounded-xl mr-2">
                <svg width="1em" height="1em" class="text-primary w-8 h-8">
                  <symbol id="macbook" viewBox="0 0 24 24">
                    <path fill="currentColor" d="M4 5v11h16V5zm-2-.993C2 3.451 2.455 3 2.992 3h18.016c.548 0 .992.449.992 1.007V18H2zM1 19h22v2H1z"/>
                  </symbol>
                  <use href="#macbook"></use>
                </svg>
              </div>
              <div>
                <p class="text-xs uppercase tracking-wider font-semibold text-gray-500">{t.about.currentJobLabel}</p>
                <p class="font-medium">{t.about.currentJob}</p>
              </div>
            </div>
          </div>
          <div class="group bg-white border border-gray-200 rounded-2xl overflow-hidden transition-all duration-300 hover:border-primary shadow-sm flex flex-col">
            <div class="p-6 flex-grow flex flex-row items-center">
              <div class="p-3 rounded-xl mr-2">
                <svg width="1em" height="1em" class="text-primary w-8 h-8">
                  <symbol id="student" viewBox="0 0 24 24">
                    <path fill="currentColor" d="M4 11.333 0 9l12-7 12 7v8.5h-2v-7.333l-2 1.166v6.678l-.223.275A9.98 9.98 0 0 1 12 22a9.98 9.98 0 0 1-7.777-3.714L4 18.011zM6 12.5v4.792A7.98 7.98 0 0 0 12 20a7.98 7.98 0 0 0 6-2.708V12.5L12 16zM3.97 9 12 13.685 20.03 9 12 4.315z"/>
                  </symbol>
                  <use href="#student"></use>
                </svg>
              </div>
              <div>
                <p class="text-xs uppercase tracking-wider font-semibold text-gray-500">{t.about.studyingLabel}</p>
                <p class="font-medium">{t.about.studying}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
  </div>
</section>