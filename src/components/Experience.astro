---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const experiences = [
  {
    title: "Be Innovation Tech",
    role: lang === 'en' ? "Functional Analyst / Developer" : "Analista Funcional / Desarrollador",
    period: "Julio 2025 - Presente",
    description: lang === 'en' ? "Functional survey and analysis, scope definition and process advice, with participation in planning, documentation, testing, training and support, focused on efficient implementations and deliverable quality." : "Relevamiento y análisis funcional, definición de alcances y asesoramiento sobre procesos, con participación en planificación, documentación, pruebas, capacitación y soporte, enfocado en implementaciones eficientes y calidad de entregables.",
    technologies: ["Odoo", "Python", "Javascript", "ERP"],
    isActive: true
  },
  {
    title: "Aurelia",
    role: lang === 'en' ? "Jr Full Stack Developer" : "Desarrollador Full Stack Jr",
    period: "Marzo 2025 — Junio 2025",
    description: lang === 'en' ? "Development of an application so that clients can create their personalized AI assistant that connects directly with their contact channels." : "Desarrollo de una aplicación para que los clientes puedan crear su asistente IA personalizado que se conecta directamente con sus canales de contacto.",
    technologies: ["Astro", "Airtable", "n8n" , "No-Code", "IA" , "Typescript"],
    isActive: false
  },
  {
    title: "Madketing",
    role: lang === 'en' ? "Functional Analyst" : "Analista Funcional",
    period: "Diciembre 2024 — Junio 2025",
    description: lang === 'en' ? "In charge of integrations with Make and n8n, development of tools via APIs, CRM management and maintenance, analytics implementation with Google Analytics and Tag Manager, UTM creation, campaign management in Meta Ads and Google Ads, and data visualization in Looker Studio." : "Encargado de integraciones con Make y n8n, desarrollo de herramientas vía APIs, gestión y mantenimiento de CRM, implementación de analítica con Google Analytics y Tag Manager, creación de UTMs, administración de campañas en Meta Ads y Google Ads, y visualización de datos en Looker Studio.",
    technologies: ["Odoo", "GHL", "JavaScript", "Google Analytics", "SEO"],
    isActive: false
  },
  {
    title: "Hospital Privado Universitario de Córdoba",
    role: lang === 'en' ? "Level 1 Support" : "Soporte Nivel 1",
    period: "Noviembre 2023 — Noviembre 2024",
    description: lang === 'en' ? "Technical support to users, resolving hardware and software incidents, account management via Active Directory, equipment maintenance and verification, remote assistance with Windows Server and VNC tools, and error reporting in systems based on user incidents." : "Soporte técnico a usuarios, resolviendo incidencias de hardware y software, gestión de cuentas mediante Active Directory, mantenimiento y verificación de equipos, asistencia remota con herramientas de Windows Server y VNC, y reporte de errores en sistemas a partir de incidencias de usuarios.",
    technologies: ["Windows Server", "Microsoft 365", "Windows Office"],
    isActive: false
  },
   {
    title: "Feas Electrónica S.A.",
    role: lang === 'en' ? "Functional Analyst" : "Analista Funcional",
    period: "Agosto 2022 — Agosto 2023",
    description: lang === 'en' ? "Internship providing support for Odoo ERP, performing functional analysis for improvements, development of tools in Python integrated to the system or via APIs, and report generation in Excel and Odoo, focusing on optimizing efficiency and functionality." : "Pasantia brindando soporte al ERP Odoo, realizando análisis funcional para mejoras, desarrollo de herramientas en Python integradas al sistema o mediante APIs, y generación de reportes en Excel y Odoo, con foco en optimizar la eficiencia y funcionalidad.",
    technologies: ["Odoo", "Python", "No Code"],
    isActive: false
  }
];
---

<section id="experience" class="full-width h-full py-10 px-4 sm:px-8 lg:px-16 xl:px-32 bg-white text-dark">
  <div class="relative max-w-[1200px] mx-auto p-4 z-10">
    <div class="flex flex-row items-center gap-3 text-3xl sm:text-4xl">
      <h2>{t.experience.title}</h2>
    </div>
    <div class="relative mt-10">
      <div class="relative space-y-12 pl-8 pb-8">
        <div class="absolute left-0 top-2 bottom-0 w-0.5 h-full bg-gray-300"></div>
        {experiences.map((exp, index) => (
          <div class="relative">
            <div class={`absolute top-2 -left-[37px] w-3 h-3 rounded-full z-10 ${exp.isActive ? 'bg-primary' : 'bg-gray-400'}`}></div>
            <div class="flex flex-col">
              <div class="flex flex-col md:flex-row md:items-baseline gap-2 md:gap-3">
                <h3 class="text-xl font-bold text-dark">{exp.title}</h3>
                <span class={`text-[14px] font-semibold text-gray-600 bg-gray-100 px-3 py-1 ring-1 rounded-lg w-fit ${exp.isActive ? 'ring-primary' : 'ring-gray-400'}`}>{exp.period}</span>
              </div>
              <p class={`text-m font-regular mt-1 ${exp.isActive ? 'text-secondary' : 'text-gray-500'}`}>{exp.role}</p>
            </div>
            <p class="mt-1 text-gray-600 max-w-3xl leading-relaxed">{exp.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>