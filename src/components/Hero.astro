---
---

<section class="flex flex-row full-width h-screen bg-gradient-to-t" id="home">
  <div class="flex flex-col items-center justify-center w-full mx-auto h-full px-4 text-center gap-y-4 z-10">
    <div class="flex items-center">
      <span class="relative inline-flex overflow-hidden rounded-full p-[2px]">
        <span class="absolute inset-[-1000%] animate-[spin_3s_linear_infinite] bg-[conic-gradient(from_90deg_at_50%_50%,#1e3a5f_0%,#0f1f33_50%,#1e3a5f_100%)]"></span>
        <div class="inline-flex items-center justify-center w-full px-4 py-1.5 text-sm rounded-full bg-primary text-white font-bold backdrop-blur-3xl whitespace-nowrap">Analista Funcional / Desarrollador</div>
      </span>
    </div>
    <h1 class=" text-white text-4xl sm:text-5xl md:text-6xl">Alvaro Bustos</h1>
    <p class="font-light text-base lg:text-lg leading-relaxed px-2 max-w-lg">
      <span class="whitespace-nowrap text-white text-secondary font-[400]">
        <strong>Analista Funcional / Desarrollador</strong>
      </span>
      <span class="text-white text-secondary font-[400] whitespace-nowrap">con+3 años</span>
      de experiencia creando soluciones digitales para empresas.
    </p>
    <div class="flex gap-x-2.5 mt-2">
      <button type="button" onclick="document.getElementById('emailModal').showModal()" class="px-4 py-2 rounded-3xl main-btn flex items-center overflow-hidden" style="--custom-border-color: rgba(255, 255, 255, 0.3)">
        <svg width="1em" height="1em" class="flex-shrink-0 mr-2">
          <symbol id="envelope" viewBox="0 0 24 24">
            <path fill="none" stroke="White" stroke-linecap="round" stroke-width="2" d="m3.5 5.5 7.893 6.036a1 1 0 0 0 1.214 0L20.5 5.5M4 19h16a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1Z"/>
          </symbol>
          <use href="#envelope"></use>
        </svg>
        <span class="text-white">¿Hablamos?</span>
      </button>
      <a href="https://www.linkedin.com/in/a-bustos-banegas" target="_blank" class="text-white px-4 py-2 rounded-3xl main-btn flex items-center overflow-hidden" style="--custom-border-color: rgba(255, 255, 255, 0.3)">
        <svg width="1em" height="1em" class="flex-shrink-0 mr-2">
          <symbol id="linkedin" viewBox="0 0 24 24">
            <g fill="White">
              <path fill-rule="evenodd" d="M12.51 8.796v1.697a3.74 3.74 0 0 1 3.288-1.684c3.455 0 4.202 2.16 4.202 4.97V19.5h-3.2v-5.072c0-1.21-.244-2.766-2.128-2.766-1.827 0-2.139 1.317-2.139 2.676V19.5h-3.19V8.796h3.168ZM7.2 6.106a1.61 1.61 0 0 1-.988 1.483 1.595 1.595 0 0 1-1.743-.348A1.607 1.607 0 0 1 5.6 4.5a1.6 1.6 0 0 1 1.6 1.606" clip-rule="evenodd"/>
              <path d="M7.2 8.809H4V19.5h3.2z"/>
            </g>
          </symbol>
          <use href="#linkedin"></use>
        </svg>
        <span class="text-white">LinkedIn</span>
      </a>
      <a href="https://github.com/Alvaro099" target="_blank" class="text-white px-4 py-2 rounded-3xl main-btn flex items-center overflow-hidden" style="--custom-border-color: rgba(255, 255, 255, 0.3)">
        <svg width="1em" height="1em" class="flex-shrink-0 mr-2">
          <symbol id="github" viewBox="0 0 24 24">
            <path fill="White" fill-rule="evenodd" d="M12.006 2a9.85 9.85 0 0 0-6.484 2.44 10.32 10.32 0 0 0-3.393 6.17 10.48 10.48 0 0 0 1.317 6.955 10.05 10.05 0 0 0 5.4 4.418c.504.095.683-.223.683-.494 0-.245-.01-1.052-.014-1.908-2.78.62-3.366-1.21-3.366-1.21a2.7 2.7 0 0 0-1.11-1.5c-.907-.637.07-.621.07-.621.317.044.62.163.885.346.266.183.487.426.647.71.135.253.318.476.538.655a2.08 2.08 0 0 0 2.37.196c.045-.52.27-1.006.635-1.37-2.219-.259-4.554-1.138-4.554-5.07a4.02 4.02 0 0 1 1.031-2.75 3.77 3.77 0 0 1 .096-2.713s.839-.275 2.749 1.05a9.26 9.26 0 0 1 5.004 0c1.906-1.325 2.74-1.05 2.74-1.05.37.858.406 1.828.101 2.713a4.02 4.02 0 0 1 1.029 2.75c0 3.939-2.339 4.805-4.564 5.058a2.47 2.47 0 0 1 .679 1.897c0 1.372-.012 2.477-.012 2.814 0 .272.18.592.687.492a10.05 10.05 0 0 0 5.388-4.421 10.47 10.47 0 0 0 1.313-6.948 10.32 10.32 0 0 0-3.39-6.165A9.85 9.85 0 0 0 12.007 2Z" clip-rule="evenodd"/>
          </symbol>
          <use href="#github"></use>
        </svg>
        <span class="text-white">Github</span>
      </a>
    </div>
  </div>
</section>